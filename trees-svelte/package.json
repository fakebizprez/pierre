{
  "name": "trees-svelte",
  "version": "0.0.0",
  "description": "Svelte 5 wrapper for @pierre/trees",
  "type": "module",
  "license": "UNLICENSED",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*"],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && find dist -name '*.test.*' -prune -exec rm -rf {} +",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.6"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@vitest/browser-playwright": "^4.0.5",
    "playwright": "1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.5",
    "vitest-browser-svelte": "^2.0.0"
  }
}
